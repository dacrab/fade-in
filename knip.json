{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"src/routes/**/*.{ts,tsx}",
		"src/sentry.client.ts",
		"src/sentry.server.ts",
		"src/integrations/convex/provider.tsx",
		"src/i18n/index.ts",
		"convex/**/*.ts"
	],
	"project": [
		"src/**/*.{ts,tsx}",
		"src/**/*.css",
		"convex/**/*.ts"
	],
	"ignoreDependencies": [
		"@tanstack/router-plugin"
	],
	"ignoreExportsUsedInFile": true,
	"ignoreBinaries": [
		"doppler"
	]
}
