{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"src/routes/**/*.{ts,tsx}",
		"src/router.tsx",
		"src/client.tsx",
		"src/server.ts",
		"src/sentry.client.ts",
		"src/sentry.server.ts",
		"src/integrations/convex/provider.tsx",
		"src/i18n/index.ts",
		"convex/**/*.ts"
	],
	"project": ["src/**/*.{ts,tsx}", "convex/**/*.ts"],
	"ignoreDependencies": ["@tanstack/router-plugin", "tailwindcss"],
	"ignoreExportsUsedInFile": true,
	"ignoreBinaries": ["doppler"]
}
