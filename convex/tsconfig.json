{
	"compilerOptions": {
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,

		/* Convex required */
		"target": "ESNext",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"isolatedModules": true,
		"noEmit": true,
		"types": ["node"],

		/* Compat */
		"allowJs": false,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true
	},
	"include": ["./**/*"],
	"exclude": ["./_generated", "./storage.ts"]
}
