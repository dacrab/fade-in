# =============================================================================
# Secrets are managed by Doppler (https://dashboard.doppler.com/workplace/projects)
# Run `doppler setup` to link this repo if not already configured.
# Run `doppler run -- <command>` to inject secrets automatically.
#
# If you don't use Doppler, copy this file to .env and fill in the values below.
# =============================================================================

# Convex (database/backend)
CONVEX_DEPLOYMENT=your-deployment-id
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Public app URL used for payment success/cancel redirects. Set it on the
# Convex deployment (server-side actions read it via process.env):
#   npx convex env set PUBLIC_SITE_URL=https://your-site-url
# Not CONVEX_SITE_URL — Convex reserves that name for its own HTTP-actions URL.
PUBLIC_SITE_URL=https://your-site-url

# Polar (payments)
POLAR_ACCESS_TOKEN=your-polar-access-token
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret

# Resend (email)
RESEND_API_KEY=re_your-api-key
RESEND_FROM=noreply@yourdomain.com

# Clerk (authentication)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-instance.clerk.accounts.dev

# Sentry (optional — disable by leaving unset)
VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Deployment environment label reported to Sentry (optional).
# Vercel sets VERCEL_ENV server-side automatically; expose the client label:
# VITE_VERCEL_ENV=production
