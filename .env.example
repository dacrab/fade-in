# Convex deployment URL — get this from your Convex dashboard (dashboard.convex.dev)
# Required for the frontend to connect to your Convex backend
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Your app's public URL — used by Convex Auth for JWT validation
# In development this is typically http://localhost:3000
# In production set this to your actual domain (e.g. https://fadein.gr)
CONVEX_SITE_URL=http://localhost:3000
