# Convex deployment URL — get this from your Convex dashboard (dashboard.convex.dev)
# Required for the frontend to connect to your Convex backend
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex deployment identifier (set automatically by `bunx convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Convex site URL (for auth HTTP endpoints)
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Note: JWT_PRIVATE_KEY and JWKS are set on the Convex deployment itself
# (not here). Run `bunx @convex-dev/auth` to generate and set them.

